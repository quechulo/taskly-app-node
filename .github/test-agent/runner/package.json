  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
