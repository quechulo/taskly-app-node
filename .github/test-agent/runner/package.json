{
  "name": "taskly-test-agent-runner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Claude Agent SDK runner for the test-engineer agent",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "agent": "tsx src/main.ts",
